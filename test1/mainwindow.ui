  <property name="styleSheet">
   <string notr="true">/* ===== 窗口与显示区：薄荷绿背景 ===== */
MainWindow {
    background-color: #e9f4ee;
}

QLineEdit#display {
    background-color: #d6ebdf;
    color: #17493a;
    border: none;
    border-radius: 14px;
    padding: 14px 12px;
    font-weight: bold;
    selection-background-color: #5e9d84;
    selection-color: #ffffff;
}

/* ===== 所有按键基础样式 ===== */
QPushButton {
    background-color: #ffffff;
    color: #1c4b3d;
    border: none;
    border-radius: 14px;
    font-weight: bold;
    min-height: 46px;
}
QPushButton:hover  { background-color: #f1f9f5; }
QPushButton:pressed{ background-color: #e2f0e9; }

/* ===== 顶行功能键：% CE C 退格（浅绿） ===== */
QPushButton#butpercent,
QPushButton#butCE,
QPushButton#butC,
QPushButton#butdelete {
    background-color: #dcefe4;
}
QPushButton#butpercent:hover,   QPushButton#butCE:hover,
QPushButton#butC:hover,         QPushButton#butdelete:hover { background-color: #d0ead9; }
QPushButton#butpercent:pressed, QPushButton#butCE:pressed,
QPushButton#butC:pressed,       QPushButton#butdelete:pressed { background-color: #c3e1cd; }

/* ===== 运算符列：÷ × − + （中绿） ===== */
QPushButton#butdivide,
QPushButton#butmultiply,
QPushButton#butminus,
QPushButton#butadd {
    background-color: #cee6da;
}
QPushButton#butdivide:hover,   QPushButton#butmultiply:hover,
QPushButton#butminus:hover,    QPushButton#butadd:hover { background-color: #c2ded2; }
QPushButton#butdivide:pressed, QPushButton#butmultiply:pressed,
QPushButton#butminus:pressed,  QPushButton#butadd:pressed { background-color: #b5d6c8; }

/* ===== 等号：深绿底白字 ===== */
QPushButton#butequal {
    background-color: #5e9d84;
    color: #ffffff;
}
QPushButton#butequal:hover   { background-color: #6cad95; }
QPushButton#butequal:pressed { background-color: #4f8b73; }</string>
